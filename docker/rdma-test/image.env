# Pinned inputs for the sparkrun RDMA test image.
#
# THE NCCL VERSION IS THE CADENCE ANCHOR. This image exists to run nccl-tests,
# so "when do we rebuild?" is answered by "NCCL cut a release" rather than by
# judgement. Bump NCCL_VERSION, bump IMAGE_TAG to match, rebuild, publish.
#
# Read by docker/rdma-test/build.sh, .github/workflows/rdma-test-image.yml and
# tests/test_rdma_image.py, which asserts DEFAULT_RDMA_TEST_IMAGE in
# sparkrun.api.setup._rdma still agrees with IMAGE_REPO:IMAGE_TAG. That drift
# guard is the point of having one file: a Python constant naming an image tag
# nobody built is worse than no default at all.

IMAGE_REPO=ghcr.io/spark-arena/sparkrun-rdma-test

# Keep IMAGE_TAG in step: nccl-<version with the leading v dropped>.
NCCL_VERSION=v2.31.2-1
IMAGE_TAG=nccl-2.31.2-1

# nccl-tests is pinned for the same reason NCCL is: it was cloned unpinned
# until upstream added the `device_api/gin` tests, whose `utils/common.cc`
# drags in the deprecated MPI C++ bindings — headers Ubuntu ships without the
# matching `libmpi_cxx`, so the link fails. That broke the build with no
# change on our side, which is precisely what a pin exists to prevent.
# v2.20.0 contains those tests; v2.19.7 does not.
NCCL_TESTS_VERSION=v2.19.7

# CUDA 13 is required for sm_121 (GB10). Only the BUILDER uses the CUDA image;
# the runtime stage is plain Ubuntu plus a staged libcudart, which is what
# keeps the image ~730 MB instead of 4.3 GB.
#
# Two spellings of the same Ubuntu release because the two registries disagree:
# NGC tags are `<cuda>-devel-ubuntu24.04`, the Ubuntu image is `ubuntu:24.04`,
# and a Dockerfile FROM has no shell to convert between them. Keep in step.
CUDA_VERSION=13.3.1
UBUNTU_VERSION=ubuntu24.04
UBUNTU_TAG=24.04

# sm_121 = GB10 (DGX Spark), the primary target. The others let the same image
# serve the `nvidia_generic` platform: sm_90 = H100/GH200, sm_100 = B200,
# sm_120 = RTX PRO Blackwell.
NVCC_GENCODE="-gencode=arch=compute_90,code=sm_90 -gencode=arch=compute_100,code=sm_100 -gencode=arch=compute_120,code=sm_120 -gencode=arch=compute_121,code=sm_121"
