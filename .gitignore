.coverage
/src/sparkrun.egg-info/
/website/node_modules/
/website/.astro/
/website/dist/
/website/package-lock.json
/MagicMock/
/build/
/benchmarks/
/.slop/
/runs/
/data/
/script-*.sh
.idea/
